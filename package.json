{
  "name": "forge3d-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Test and tooling entry points. Node is not in the runtime path — see ADR-008.",
  "type": "module",
  "scripts": {
    "test:backend": "node tools/run-pytest.mjs -q",
    "test:frontend": "node --test frontend/tests/",
    "test:frontend:browser": "node --test frontend/tests-browser/smoke.test.js",
    "test": "npm run test:backend && npm run test:frontend",
    "lint:design": "node tools/lint-design-tokens.mjs",
    "tokens": "node tools/generate-tokens.mjs"
  },
  "devDependencies": {
    "puppeteer": "^23.0.0"
  }
}
